APP_URL=http://localhost:5173
PORT=3001
# Omit DATABASE_URL for local SQLite. Production requires MySQL.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/smarttutor
# DATA_DIR=/absolute/persistent/directory
# PERSISTENT_DISK=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET=
# TRUST_PROXY=1
# MySQL TLS: never disable server certificate verification.
# DB_SSL=true
# DB_SSL_CA_FILE=/path/to/provider-ca.pem
# Private, S3-compatible storage. Bucket must NOT allow public listing/reads.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Optional: queue a first-admin invitation automatically on first deployment.
# INITIAL_ADMIN_EMAIL=your-school-email@example.edu
