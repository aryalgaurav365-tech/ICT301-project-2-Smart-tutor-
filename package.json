{
  "name": "smarttutor",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "node scripts/check-deployment-config.mjs && npm run build -w apps/web",
    "start": "npm start -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "admin:invite": "npm run invite -w apps/api --",
    "jobs": "npm run worker -w apps/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": "24.x"
  }
}
